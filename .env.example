# Neon PostgreSQL connection string (use sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Brevo (Sendinblue) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-your-api-key"

# Verified sender in Brevo (must match an authorized sender)
SENDER_EMAIL="you@example.com"

# Domain used for generated disposable addresses: user_<random>@<DISPOSABLE_EMAIL_DOMAIN>
DISPOSABLE_EMAIL_DOMAIN="yourdomain.com"

# Optional: Mistral API key for AI-drafted outreach (https://console.mistral.ai/)
MISTRAL_API_KEY=""

# Comma-separated model ids (first = preferred). Versioned ids avoid 503 unreachable_backend on some `-latest` aliases.
# Example: mistral-small-2503,open-mistral-7b,ministral-8b-2410
MISTRAL_MODEL=""

# Comma-separated origins allowed for the web app (CORS)
WEB_ORIGIN="http://localhost:5173"
